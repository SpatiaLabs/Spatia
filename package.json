{
  "name": "spatia",
  "version": "0.5.2",
  "description": "Spatia — a local-first visual infinite workspace.",
  "author": "Spatia",
  "license": "MIT",
  "private": true,
  "main": "dist/main/main/main.js",
  "scripts": {
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "tsc -p tsconfig.renderer.json && node scripts/copy-renderer-assets.js",
    "build:web": "node scripts/build-web.js",
    "build:test": "tsc -p tsconfig.tests.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build:test && node --test dist/test/tests/*.test.js",
    "test:server": "npm run build:test && npm --prefix server test",
    "server": "node server/server.js",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "package:msi": "npm run build && node scripts/make-ico.js && node scripts/package-win.js msi",
    "package:zip": "npm run build && node scripts/make-ico.js && node scripts/package-win.js zip"
  },
  "build": {
    "appId": "com.spatia.desktop",
    "productName": "Spatia",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "asar": true,
    "electronLanguages": [
      "en-US"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Spatia-${version}-win-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Graphics",
      "executableName": "spatia",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "fileAssociations": [
        {
          "ext": "spatia",
          "name": "Spatia Canvas",
          "description": "Spatia canvas document"
        },
        {
          "ext": "spatia.json",
          "name": "Spatia Canvas JSON",
          "description": "Spatia canvas document (JSON)"
        }
      ]
    },
    "msi": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Spatia"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "electron": "^30.0.0",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.4",
    "typescript": "^5.4.5"
  }
}
