# Copy this file to `.env` (or set the variables in your environment / deploy
# configuration) and fill in real values. Never commit real secrets: this
# repository contains placeholders only.

# Required by the "Report a problem" endpoint (cloudflare/report-worker/). Sends rendered reports by email via
# the Resend API. Get a key from https://resend.com/api-keys.
RESEND_API_KEY=

# The sender address for report emails. Must be a verified sender on your
# Resend account (domain or single-address verification).
REPORT_FROM=

# Where reports are delivered. Defaults to the project's support inbox
# (spatiacanvas@gmail.com).
REPORT_TO=

# Subject line used for report emails.
REPORT_SUBJECT=

# Optional. Overrides the source image used by scripts/make-ico.js to generate
# build/icon.ico. Defaults to the in-repo icon
# (Spatia Download & Web/assets/icon-512.png).
SPATIA_ICON_PNG=